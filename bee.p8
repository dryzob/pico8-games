pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- bee game

-- main loop

bee_spr=1

function _init()
	poke(0x5f2d, 1)
	-- this might be moved
	t=0
	bees={}
	_upd=upd_bview
	_drw=drw_bview
end

function _update()
	t+=1
	if t>30 then
		t=0
	end
 -- start (do later)
 -- bee view
 if t==30 then
 	make_bee(stat(32),stat(33),10)
	end
end

function _draw()
	cls(0)
	map()
	
	drw_menu()
	_drw()
	drw_mouse()
end

function upd_bview()
	-- show bees, hive and flowers
	-- drw and upd?
	_drw=drw_bview
	
end


-->8
-- tools

function drawspr(_spr,_x,_y,_c,_f)
	palt(0,false)
	palt(15,true)
	pal(6,_c)
	spr(_spr,_x,_y,1,1,_f)
	pal()
	palt()
end
-->8
-- draw
function drw_bview()
 -- sprites for bees
 for b in all(bees) do
 	drw_bee(b)
	end
end

function drw_bee(b)
	drawspr(b.sprite,b.x,b.y,b.col,b.flp)
end

function drw_mouse()
	drawspr(17,stat(32),stat(33),10,false)
	--print(stat(34))
end

function drw_menu()
	-- bunch of squares
	-- these will have hitboxes
	-- (buttons)
	local maxh=9*8
	local minh=14*8
	local sqw=25
	local sqh=10
	
	local numsq=(minh-maxh)/sqh
	local gap=1
	for i=0,numsq do
		rrectfill(4,(maxh+gap+i*sqh),sqw,sqh,1,5)
		gap+=1
	end
end	
-->8
--bees

function make_bee(bx,by,bcol)
	local b={
		x=bx,y=by,
		sprite=bee_spr,
		col=bcol,
		flp=false
	}
	add(bees,b)
	return b
end


