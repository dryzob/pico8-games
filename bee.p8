-- draw

mouse_spr=15



function drw_bview()
	camera(0,0)
 -- sprites for bees
 for b in all(bees) do
 	drw_bee(b)
	end
end

function drw_bee(b)
	local r=2
	drawspr(getframe(b.sprite,r),b.x,b.y,b.col,b.flp)
end

function drw_mouse()
	drawspr(mouse_spr,stat(32),stat(33),10,false)
	--print(stat(34))
end

function drw_menu()
	--buttons
	for but in all(buttons) do
		local w,h=but.x2-but.x1,but.y2-but.y1
		rrectfill(but.x1,but.y1,w,h,1,5)
		rrect(but.x1,but.y1,w,h,1,0)
			if but.down==false then
				rrectfill(but.x1+2,but.y1-2,w-4,h,1,6)
				rrect(but.x1+2,but.y1-2,w-4,h,1,0)
			else
				rrectfill(but.x1+2,but.y1-1,w-4,h,1,6)
				rrect(but.x1+2,but.y1-1,w-4,h,1,0)
			end
		-- labels
		local lx,ly=but.x1+w+4,but.y1+3
		printb(but.upg.cnt..": "..but.upg.txt,lx,ly,7)
		-- price
		lx,ly=but.x1+5,but.y1+2
		printb("$"..but.upg.prc,lx,ly,7)
	end
	
end	

function drw_money()
	local x=4
	local y=4
	printb("$"..money,x,y,9)
end

function drw_wldmap()
	camera(18*8,0)
end
-->8
--bees

bee_spr={1,2}
bee_spawn={2*8,6*8}
targets={0,30,4}

bee_speed=0.25
bee_hovert=5*30
bee_prod=1

function make_bee(bx,by,bcol)
	local b={
		x=bx,y=by,
		sprite={bee_spr[1],bee_spr[2]},
		col=bcol,
		flp=false,
		tar=targets[1],
		goal={0,0},
		fnd=false,
		hover=false,
		ht=0,
		pol=false
	}
	add(bees,b)
	return b
end

function bee_do()
	for b in all(bees) do
	
		if b.hover==true then
			bee_hover(b)
		elseif abs(b.goal[1]-b.x)<2 and abs(b.goal[2]-b.y)<2 then
			b.fnd=false
			if mget(b.x/8,b.y/8)==30 then
				money+=1
			end
		end
		
		if not b.fnd then
			bee_find(b)
		else
			bee_move(b)
		end
	end
end

function bee_move(b) 
	local t=10
	
	local dx=b.goal[1]-b.x
	local dy=b.goal[2]-b.y
	
	if dx>0 then
		b.flp=false
	else
		b.flp=true
	end
	
	-- far from goal
	if dx>t or dx<-t then
		if dy<t then
			local ran=rnd(2)
			if ran>1 then
				b.y+=bee_speed
			elseif ran<1 then
				b.y-=bee_speed
			end
		elseif dy>=t then
			b.y+=bee_speed
		elseif dy<=-t then
			b.y-=bee_speed
		end
		if b.x>b.goal[1] then
			b.x-=bee_speed
		elseif b.x<b.goal[1] then
			b.x+=bee_speed
		end
	-- close to goal
	else
		if b.x>b.goal[1] then
			b.x-=bee_speed
		elseif b.x<b.goal[1] then
			b.x+=bee_speed
		end
		if b.y>b.goal[2] then
			b.y-=bee_speed
		elseif b.y<b.goal[2] then
			b.y+=bee_speed
		end
	end
end

function bee_find(b)
	if b.tar==targets[1] then
		b.goal=find(targets[3])
		b.tar=targets[3]
	elseif b.tar==targets[2] then
		b.goal=find(targets[2])
		b.tar=targets[3]
	elseif b.tar==targets[3] then
		b.goal=find(targets[3])
		b.tar=targets[2]
	end
	b.fnd=true
end

function bee_hover(b)

end
