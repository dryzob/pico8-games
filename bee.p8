pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- bee game

-- main loop

function _init()
	poke(0x5f2d, 1)
	-- this might be moved
	t=0
	bees={}
	make_bee(bee_spawn[1],bee_spawn[2],10)
	_upd=upd_bview
	_drw=drw_bview
end

function _update()
	t+=1
	if t>30 then
		t=0
	end
 -- start (do later)
 -- bee view
 if btn(❎) then
 	make_bee(stat(32),stat(33),10)
	end
	bee_do()
end

function _draw()
	cls(0)
	map()
	
	drw_menu()
	_drw()
	drw_mouse()
end

function upd_bview()
	-- show bees, hive and flowers
	-- drw and upd?
	_drw=drw_bview
	
end


-->8
-- tools

function drawspr(_spr,_x,_y,_c,_f)
	palt(0,false)
	palt(15,true)
	pal(6,_c)
	spr(_spr,_x,_y,1,1,_f)
	pal()
	palt()
end

function find(t)
	local mx=15*8
	local my=8*8
	for i=0,mx do
		for j=0,my do
			if mget(i,j)==t then
				return {i,j}
			end
		end
	end
	return {0,0}
end
-->8
-- draw

mouse_spr=15

function drw_bview()
 -- sprites for bees
 for b in all(bees) do
 	drw_bee(b)
	end
end

function drw_bee(b)
	drawspr(b.sprite,b.x,b.y,b.col,b.flp)
end

function drw_mouse()
	drawspr(mouse_spr,stat(32),stat(33),10,false)
	--print(stat(34))
end

function drw_menu()
	-- bunch of squares
	-- these will have hitboxes
	-- (buttons)
	local maxh=9*8
	local minh=14*8
	local sqw=25
	local sqh=10
	
	local numsq=(minh-maxh)/sqh
	local gap=1
	for i=0,numsq do
		rrectfill(4,(maxh+gap+i*sqh),sqw,sqh,1,5)
		gap+=1
	end
end	
-->8
--bees

bee_spr=1
bee_spawn={2*8,6*8}
targets={0,30,4}

function make_bee(bx,by,bcol)
	local b={
		x=bx,y=by,
		sprite=bee_spr,
		col=bcol,
		flp=false,
		tar=targets[3],
		goal={0,0},
		fnd=false
	}
	add(bees,b)
	return b
end

function bee_do()
	for b in all(bees) do
		if b.goal=={b.x,b.y} then
			-- retarget
			print("new target")
		end
		if not b.fnd then
			bee_find(b)
		else
			bee_move(b)
		end
	end
end

function bee_move(b)
	if b.x>b.goal[1] then
		b.x-=1
	elseif b.x<b.goal[1] then
		b.x+=1
	end
	if b.y>b.goal[2] then
		b.y+=1
	elseif b.y<b.goal[2] then
		b.y-=1
	end
end

function bee_find(b)
	if b.tar==targets[1] then
		b.tar=targets[3]
	end
	if b.tar==targets[2] then
		b.goal=find(targets[2])
	end
	if b.tar==targets[3] then
		b.goal=find(targets[3])
	end
	if b.goal!={0,0} then
		b.fnd=true
	end
end
