-- bee game

-- main loop

function _init()
	poke(0x5f2d, 1)
	pq("--------------------------")
	-- this might be moved
	t=0
	bees={}
	buttons={}
	money=100
	
	gen_menu()
	make_bee(bee_spawn[1],bee_spawn[2],10)
	_upd=upd_bview
	_drw=drw_bview
end

function _update()
	t+=1
	if t>30 then
		t=0
		pq("--------------")
	end
	
	if t%10==0 then
		
	end
	
	if btn(❎) then
		_drw=drw_wldmap
	else
		_drw=drw_bview
	end
	
	
	click_but()
	but_bounce()
	
	bee_do()
end

function _draw()
	cls(0)
	map()
	
	drw_menu()
	_drw()
	drw_mouse()
	drw_money()
end

function upd_bview()
	-- show bees, hive and flowers
	-- drw and upd?
	_drw=drw_bview
	
end


-->8
-- tools

function drawspr(_spr,_x,_y,_c,_f)
	palt(0,false)
	palt(15,true)
	pal(6,_c)
	spr(_spr,_x,_y,1,1,_f)
	pal()
	palt()
end

function find(tile)
	local mx=15*8
	local my=8*8
	for i=0,mx do
		for j=0,my do
			if mget(i,j)==tile then
				return {i*8,j*8}
			end
		end
	end
	return {0,0}
end

function getframe(ani,r)
	return ani[flr(t/r)%#ani+1]
end

function printb(txt,x,y,col)
	print(txt,x-1,y,0)
	print(txt,x+1,y,0)
	print(txt,x,y+1,0)
	print(txt,x,y-1,0)
	print(txt,x,y,col)
end

-- pq by pancelor: lexaloffle.com/bbs/?tid=42367
function pq(...)printh(qq(...))return...end
function qq(...)local r=""for i=1,select("#",...)do r..=_q(select(i,...),4).." "end return r end
function _q(t,d)if(type(t)~="table"or d<=0)return tostr(t)
local r="{"for k,v in next,t do r..=tostr(k).."=".._q(v,d-1)..","end return r.."}"end

-- overlap function by mboffin on itch.io
function overlap(a,b)
 return not (a.x>b.x+b.w 
          or a.y>b.y+b.h 
          or a.x+a.w<b.x 
          or a.y+a.h<b.y)
end
