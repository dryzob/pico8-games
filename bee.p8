-- ui

upgrades={-- default values
	-- bee count
		{txt="bEES",
			prc=5,
			cnt=1},
	-- speed
		{txt="sPEED",
			prc=10,
			cnt=1},
	-- hover time
		{txt="hOVER tIME",
			prc=50,
			cnt=1},
	-- productivity
		{txt="pRODUCTIVITY",
			prc=100,
			cnt=1}
		}

function make_but(bx1,bx2,by1,by2,bupg)
	but={
		x1=bx1,
		x2=bx2,
		y1=by1,
		y2=by2,
		down=false,
		dt=0,
		upg=bupg
	}
	add(buttons,but)
end

function gen_menu()
 
	local maxh=9*8
	local minh=14*8
	-- buttons
	local sqw=25
	local sqh=12
	
	local numsq=(minh-maxh)/sqh
	local gap=2
	local upval=1
	for i=0,numsq do
		local x1=4
		local x2=x1+sqw
		local y1=(maxh+gap+i*sqh)
		local y2=y1+sqh
		gap+=2
		make_but(x1,x2,y1,y2,upgrades[upval])
		upval+=1
	end
end

function but_collision(but)
	-- rewrite collider and this func
	local m={
			x=stat(32),y=stat(33),w=1,h=1
		}
	local b={
			x=but.x1,y=but.y1,
			w=but.x2-but.x1,h=but.y2-but.y1
		}	
	local c=overlap(m,b)	
	return c	
end

function but_bounce()
 local down_time=5
	for b in all(buttons) do
		if b.down==true then
			b.dt+=1
		end
		if b.dt>down_time then
			b.dt=0
			b.down=false
		end
	end
end

function click_but()
	local c=false
	if stat(34)==1 then
		for b in all(buttons) do
			if b.down==false then
				c=but_collision(b)
				if c then
					buy_upgrade(b)
					b.down=true
					b.dt=0
				end
			end
		end
	end
end

function buy_upgrade(but)
	local upg_name=but.upg.txt
	local upg_price=but.upg.prc
	
	if money>=upg_price then
		if upg_name=="bEES" then
			make_bee(bee_spawn[1],bee_spawn[2],10)
		elseif upg_name=="sPEED" then
			bee_speed+=0.25
			pq("speed: "..bee_speed)
		elseif upg_name=="hOVER tIME" then
		
		elseif upg_name=="pRODUCTIVITY" then
		
		end
		money-=but.upg.prc
		but.upg.prc*=2
		but.upg.cnt+=1
	end
end

