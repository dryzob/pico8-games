pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--[[rougelike game
	tutorial found on youtube
	by lazy devs
	last ep finished: 14
]]
function _init()
	t=0
	
	dpal={0,1,1,2,1,13,6,4,4,9,3,13,1,13,14}
		
	dirx={-1,1,0,0,1,1,-1,-1}
	diry={0,0,-1,1,-1,1,1,-1}
	
	mob_ani={240,192}
	mob_atk={1,1}
	mob_hit={5,2}
	
	debug={}
	startgame()
	
end

function _update60()
	t+=1
	_upd()
	dofloat()
end

function _draw()
	_drw()
	drawind()
	dohpwind()
	checkfade()
	cursor(4,4)
	color(8)
	for txt in all(debug) do
		print(txt)
	end
end

function startgame()
	fadeperc=1
	buttbuff=-1
	mob={}
	dmob={}
	
	for x=0,15 do
		for y=0,15 do
			if mget(x,y)==3 then
				addmob(2,x,y)
			end
		end
	end
	p_mob=addmob(1,1,1)

	p_t=0
	
	wind={}
	float={}
	talkwind=nil
	
	hpwind=addwind(5,5,28,13,{})
	
	_upd=upd_game
	_drw=drw_game
end

-->8
-- updates

function upd_game()
	if talkwind then
		if getbutt()==5 then
			talkwind.dur=0
			talkwind=nil
		end
	else	
		dobuttbuff()
		dobutt(buttbuff)
		buttbuff=-1
	end
end

function upd_pturn()
	dobuttbuff()
	p_t=min(p_t+0.125,1)
	
	p_mob.mov(p_mob,p_t)
	
	if p_t==1 then
		_upd=upd_game
		if checkend() then
			doai()
		end
	end
end

function upd_aiturn()
	dobuttbuff()
	p_t=min(p_t+0.125,1)
	
	for m in all(mob) do
		if m!=p_mob and m.mov then
			m.mov(m,p_t)
		end
	end
	if p_t==1 then
		_upd=upd_game
		checkend()
	end
end

function upd_gameover()
	if btnp(❎) then
		fadeout()
		startgame()
	end
end

function getbutt()
	for i=0,5 do
		if btnp(i) then
			return i
		end
	end
	return -1
end

function dobuttbuff()
	if buttbuff==-1 then
		buttbuff=getbutt()
	end
end

function dobutt(butt)
	if (butt<0) return
	if butt<4 then	
		moveplayer(dirx[butt+1],diry[butt+1])
		
	end
	--menu buttons here
end
-->8
-- draws

function drw_game()
	cls(0)
	map()
	for m in all(dmob) do
		if sin(time()*8)>0 then
			drawmob(m)
		end
		m.dur-=1
		if m.dur<=0 then
			del(dmob,m)
		end
	end
	
	for m in all(mob) do
		if m!=p_mob then
			drawmob(m)
		end
	end
	drawmob(p_mob)
	
	for f in all(float) do
		oprint8(f.txt,f.x,f.y,f.c,0)
	end
	
end

function drawmob(m)
	local col=10
	if m.flash>0 then
		m.flash-=1
		col=7
	end
	drawspr(getframe(m.ani),m.x*8+m.ox,m.y*8+m.oy,col,m.flp)
end

function drw_gameover()
	cls()
	print("git gud",50,50)
end
-->8
-- tools

function getframe(ani)
	return ani[flr(t/15)%#ani+1]
end

function drawspr(_spr,_x,_y,_c,_f)
	palt(0,false)
	pal(6,_c)
	spr(_spr,_x,_y,1,1,_f)
	pal()
end

function rectfill2(_x,_y,_w,_h,_c)
	rectfill(_x,_y,_x+max(_w-1,0),_y+max(_h-1,0),_c)
end

function oprint8(_t,_x,_y,_c,_c2)
	for i=1,8 do
		print(_t,_x+dirx[i],_y+diry[i],_c2)
	end
	print(_t,_x,_y,_c)
end

function dist(fx,fy,tx,ty)
	local dx,dy=fx-tx,fy-ty
	return sqrt(dx*dx+dy*dy)
end

function dofade()
 local p,kmax,col,k=flr(mid(0,fadeperc,1)*100)
 for j=1,15 do
  col = j
  kmax=flr((p+(j*1.46))/22)
  for k=1,kmax do
   col=dpal[col]
  end
  pal(j,col,1)
 end
end

function checkfade()
	if fadeperc>0 then
		fadeperc=max(fadeperc-0.04,0)
		dofade()
	end
end

function wait(_wait)
	repeat
		_wait-=1
		flip()
	until _wait<0
end

function fadeout(spd,_wait)
 if (spd==nil) spd=0.04
 if (_wait==nil) _wait=0
 repeat
  fadeperc=min(fadeperc+spd,1)
  dofade()
  flip()
 until fadeperc==1
 wait(_wait)
end
-->8
-- gameplay

function moveplayer(dx,dy)
	local destx,desty=p_mob.x+dx,p_mob.y+dy
	local tle=mget(destx,desty)
	
	mobflp(p_mob,dx,dy)
		
	if iswalkable(destx,desty,"checkmobs") then
		sfx(3)
		mobwalk(p_mob,dx,dy)
		p_t=0
		_upd=upd_pturn
	else
		-- no walk
		mobbump(p_mob,dx,dy)
		p_t=0
		_upd=upd_pturn
		
		local mob=getmob(destx,desty)
		if mob==false then
			if fget(tle,1) then
				trig_bump(tle,destx,desty)
			else
				sfx(1)
			end
		else
			sfx(6)
			hitmob(p_mob,mob)
		end
	end
end

function trig_bump(tle,destx,desty)

		if tle==7 or tle==8 then
		--vase
		sfx(4)
		mset(destx,desty,1)
	elseif tle==10 or tle==12 then
		--chest
		sfx(2)
		mset(destx,desty,tle-1)
	elseif tle==13 then
		--door
		sfx(5)
		mset(destx,desty,1)
	elseif tle==6 then
		-- tablet
		if destx==0 and desty==2 then
			showmsg({"welcome to pork",
												"here will be evil",
												"beasts and traps.",
												"","good luck!"})
		elseif destx==8 and desty==5 then
			showmsg({"cheese"})
		end
		--	addwind(32,64,56,18,{"welcome to the world","of porklike"})
	end
end

function getmob(_x,_y)
	for m in all(mob) do
		if m.x==_x and m.y==_y then
			return m
		end
	end
	return false
end

function iswalkable(_x,_y,mode)
	if mode==nil then mode="" end
	if not outbounds(_x,_y) then
		local tle=mget(_x,_y)
		if fget(tle,0)==false then
			if mode=="checkmobs" then
				return getmob(_x,_y)==false
			end
		return true
		end
	end
	return false	
end

function outbounds(_x,_y)
	return (_x<0 or _y<0 or _x>15 or _y>15)
end

function hitmob(atkm,defm)
	local dmg=atkm.atk
	defm.hp-=dmg
	defm.flash=10
	
	addfloat("-"..dmg,defm.x*8,defm.y*8,9)
	
	if defm.hp<=0 then
		-- player gameover?
		add(dmob,defm)
		del(mob,defm)
		defm.dur=20
	end
end

function checkend()
	if p_mob.hp <= 0 then
		_upd=upd_gameover
		_drw=drw_gameover
		fadeout()
		return false
	end
	return true
end
-->8
-- ui

function addwind(_x,_y,_w,_h,_txt)
	return add(wind,{x=_x, y=_y,
																		w=_w, h=_h,
																		txt=_txt})
end

function drawind()
	for w in all(wind) do
		-- window
		local wx,wy,ww,wh=w.x,w.y,w.w,w.h
		rectfill2(wx,wy,ww,wh,0)
		rect(wx+1,wy+1,wx+ww-2,wy+wh-2,6)
		-- text
		wx+=4
		wy+=4
		clip(wx,wy,ww-8,wh-8)
		for i=1,#w.txt do
			local txt=w.txt[i]
			print(txt,wx,wy,6)
			wy+=6
		end
		clip()
				
		if w.dur!=nil then
			w.dur-=1
			if w.dur<=0 then
				local dif=w.h/4
				w.y+=dif/2
				w.h-=dif
				if wh<3 then
					del(wind,w)
				end
			end
		else
			if w.butt then
				oprint8("❎",wx+ww-14,wy-2+sgn(sin(time())),6,0)
			end
		end
	end
end

function showmsg(txt,dur) -- in frames
	local wid=(#txt+2)*4+7
	local w=addwind(63-wid/2,50,wid,13,{" "..txt})
	w.dur=dur
end

function showmsg(txt)
	talkwind=addwind(16,50,94,#txt*6+7,txt)
	talkwind.butt=true
end

function addfloat(_txt,_x,_y,_c)
	add(float,{txt=_txt,x=_x,y=_y,c=_c,ty=_y-10,t=0})
end

function dofloat()
	for f in all(float) do
		f.y+=(f.ty-f.y)/10
		f.t+=1
		if f.t >70 then
			del(float,f)
		end
	end
end

function dohpwind()
	hpwind.txt[1]="♥"..p_mob.hp.."/"..p_mob.hpmax
	local hpy=5
	if p_mob.y<8 then
		hpy=110
	end
	hpwind.y+=(hpy-hpwind.y)/5
end
-->8
-- mobs

function addmob(typ,mx,my,ani)
	local m={
		x=mx,	y=my,
		ox=0,	oy=0,
		sox=0,	soy=0,
		flp=false,
		mov=nil,
		ani={},
		flash=0,
		hp=mob_hit[typ],
		hpmax=mob_hit[typ],
		atk=mob_atk[typ]
	}
	for i=0,3 do
		add(m.ani,mob_ani[typ]+i)
	end
	add(mob,m)
	return m
end

function mobflp(m,dx,dy)
 m.flp=dy!=0 and m.flp or dx<0
end

function mobwalk(m,dx,dy)
	m.x+=dx
	m.y+=dy
	
	mobflp(m,dx)
	m.sox,m.soy=-dx*8,-dy*8
	m.ox,m.oy=m.sox,m.soy
	
	m.mov=mov_walk
end

function mobbump(m,dx,dy)
		m.sox,m.soy=dx*8,dy*8
		m.ox,m.oy=0,0
		
		m.mov=mov_bump
end

function mov_walk(m,at)
	m.ox=m.sox*(1-at)
	m.oy=m.soy*(1-at)
end

function mov_bump(m,at)
	-- ★
	local tme=at
	if at>0.5 then
		tme=1-at
	end
	m.ox=m.sox*tme
	m.oy=m.soy*tme
end

function doai()
	for m in all(mob) do
		if m!=p_mob then
			m.mov=nil
			if dist(m.x,m.y,p_mob.x,p_mob.y)==1 then
				-- attack
				dx,dy=p_mob.x-m.x,p_mob.y-m.y
				mobbump(m,dx,dy)
				hitmob(m,p_mob)
				sfx(7)
			else
				-- move toward		
				local bdst,bx,by=999,0,0
				for i=1,4 do
					local dx,dy=dirx[i],diry[i]
					local tx,ty=m.x+dx,m.y+dy
					if iswalkable(tx,ty,"checkmobs") then
						local dst=dist(tx,ty,p_mob.x,p_mob.y)
						if dst<bdst then
							bdst,bx,by=dst,dx,dy
						end
					end
				end
				mobwalk(m,bx,by)
				_upd=upd_aiturn
				p_t=0
			end
		end
	end
end
